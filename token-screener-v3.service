[Unit]
Description=Robinhood Chain token screener v3 (watch-launches.js, Gates 0-6 incl. 5c)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/botuser/bot-v3
# --since 15m: after any restart, re-scan the last 15 minutes so a launch
# during the restart is not missed. Tokens already in launches.jsonl are
# never screened twice.
# --source-recheck / --source-feed (2026-11-05-source-feed): a hidden-source token is looked up
# when the explorer's newly-verified list names it (read every 60 s), with backup lookups at
# 30 s, 5 min, 30 min, 2 h, and given up at 24 h.
ExecStart=/usr/bin/node /home/botuser/bot-v3/watch-launches.js --since 15m --source-recheck 30,300,1800,7200,86400 --source-feed 60
Restart=always
RestartSec=10
# The watcher writes its own full log to /home/botuser/bot-v3/logs/ (one file
# per start), so stdout is not duplicated here. Crashes still land in
# service-error.log.
StandardOutput=null
StandardError=append:/home/botuser/bot-v3/service-error.log

[Install]
WantedBy=multi-user.target
